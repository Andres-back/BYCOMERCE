{
  "name": "@mocoa-market/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/copy-generated.mjs",
    "start": "node dist/src/main.js",
    "start:dev": "node scripts/copy-generated.mjs && nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1068.0",
    "@aws-sdk/s3-request-presigner": "3.1068.0",
    "@nestjs/common": "11.1.26",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.26",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/platform-express": "11.1.26",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "5.22.0",
    "@types/cron": "^2.0.1",
    "@types/multer": "^2.1.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cron": "^4.4.0",
    "helmet": "8.2.0",
    "multer": "^2.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.26",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "prisma": "5.22.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.11",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
