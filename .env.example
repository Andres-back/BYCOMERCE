NODE_ENV=development

# Docker / database
POSTGRES_DB=mocoastore
POSTGRES_USER=mocoa
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://mocoa:change_me@postgres:5432/mocoastore?schema=public

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://mocoastore.alexsters.works,https://app.mocoastore.alexsters.works
JWT_ACCESS_SECRET=replace_with_256_bit_secret
JWT_REFRESH_SECRET=replace_with_different_256_bit_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_COST=12

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=mocoa_minio
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=mocoa-market

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors

